{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HelaScript",
  "scopeName": "source.hela",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#function-declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.hela",
          "match": "//.*$"
        },
        {
          "name": "comment.block.hela",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.hela",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.hela",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.hela",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.hela",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.template.hela",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.hela",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "(වැඩේ)(?:\\s+(නොපෙනෙන))?\\s+([\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z_][\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.hela" },
            "2": { "name": "keyword.control.async.hela" },
            "3": { "name": "entity.name.function.hela" }
          }
        },
        {
          "match": "(නොපෙනෙන)\\s+(වැඩේ)\\s+([\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z_][\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.async.hela" },
            "2": { "name": "storage.type.function.hela" },
            "3": { "name": "entity.name.function.hela" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.type.hela",
          "match": "(?<![\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_])(දාන්න|වෙනස්නොවන)(?![\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_])"
        },
        {
          "name": "storage.type.function.hela",
          "match": "(?<![\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_])(වැඩේ)(?![\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_])"
        },
        {
          "name": "keyword.control.flow.hela",
          "match": "(?<![\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_])(ඉදින්|නැත්තම්|කියනකල්|හැම|යවන්න|නවත්වන්න|බිඳින්න|ඊළඟ|ඉදිරියට|උත්සාහ|අල්ලන්න)(?![\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_])"
        },
        {
          "name": "keyword.control.async.hela",
          "match": "(?<![\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_])(නොපෙනෙන|ඉන්න)(?![\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_])"
        },
        {
          "name": "keyword.control.import.hela",
          "match": "(?<![\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_])(ගෙන්නන්න|ගෙන්)(?![\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_])"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.hela",
          "match": "(?<![\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_])(ඇත්ත|බොරු|true|false)(?![\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_])"
        },
        {
          "name": "constant.language.null.hela",
          "match": "(?<![\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_])(හිස්|null)(?![\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_])"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.hela",
          "match": "(?<![\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_])(ලියන්න|අරගන්න|ලබාගන්න|දිග|වර්ගය|සංඛ්‍යාව|අකුරු|නිදන්න|කාලය)(?=[\\s(])"
        },
        {
          "name": "support.class.builtin.hela",
          "match": "(?<![\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_])(ගණිතය|Math|process)(?![\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_])"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "([\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z_][\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.hela" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.hela",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.decimal.hela",
          "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.hela",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.hela",
          "match": "(=|\\+=|\\-=|\\*=|\\/=)"
        },
        {
          "name": "keyword.operator.arithmetic.hela",
          "match": "(\\+|\\-|\\*|\\/|%)"
        },
        {
          "name": "keyword.operator.logical.hela",
          "match": "(&&|\\|\\||!|(?<![\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_])(සහ|හෝ|නැත)(?![\\u0D80-\\u0DFF\\u200C\\u200Da-zA-Z0-9_]))"
        },
        {
          "name": "keyword.operator.arrow.hela",
          "match": "=>"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.hela",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.hela",
          "match": ","
        },
        {
          "name": "punctuation.accessor.dot.hela",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.colon.hela",
          "match": ":"
        },
        {
          "name": "punctuation.bracket.hela",
          "match": "[\\[\\](){}]"
        }
      ]
    }
  }
}
